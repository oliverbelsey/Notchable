# Xcode: build output
# ---------------------------------
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

# ---------------------------------
# Xcode: user-specific state
# ---------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# Xcode workspace settings that are per-user
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Timeline / playground leftovers
timeline.xctimeline
playground.xcworkspace

# ---------------------------------
# Swift Package Manager
# ---------------------------------
.build/
.swiftpm/
# Uncomment if you are building a library and don't want to pin versions:
# Package.resolved

# ---------------------------------
# CocoaPods (if used)
# ---------------------------------
Pods/
# Uncomment to ignore the lockfile too (most teams commit it):
# Podfile.lock

